import os
import sqlite3
from typing import Any, Final

from diskcache_community.core import SafeDisk

ENV_KEY_FILE: Final[str]
MAGIC: Final[bytes]
VERSION: Final[int]
HEADER_SIZE: Final[int]
PREFIX_SIZE: Final[int]
MIN_KEY_SIZE: Final[int]
NUMPY_REFUSED: Final[str]

class _Key:
    key_id: bytes
    def __init__(self, key: bytes) -> None: ...
    def mac(self) -> Any: ...

class KeyFile:
    path: str | None
    def __init__(self, path: str | None) -> None: ...
    def load(self, directory: str) -> tuple[_Key, str]: ...

class InMemoryKey:
    key: _Key
    def __init__(self, key: bytes) -> None: ...
    def load(self, directory: str) -> tuple[_Key, None]: ...

def source(
    cls: type[SafeDisk], key_file: Any, key: bytes | None
) -> KeyFile | InMemoryKey: ...
def default_key_file() -> str: ...
def data_directory(
    environ: os._Environ[str] | dict[str, str], platform: str, home: str
) -> str | None: ...
def load_key_file(path: str, directory: str) -> tuple[_Key, str]: ...
def check_permissions(status: os.stat_result, path: str) -> None: ...
def check_directory(disk: Any, directory: str) -> None: ...
def stored_raw(value: Any) -> bool: ...
def store(
    disk: SafeDisk, value: Any, key: Any
) -> tuple[int, int, str | None, Any]: ...
def finish(db_value: Any, key: tuple[Any, bool]) -> Any: ...
def fetch(
    disk: SafeDisk,
    filename: str | None,
    value: bytes | sqlite3.Binary | None,
    key: tuple[Any, bool] | None,
) -> Any: ...
def refuse_signed(value: Any) -> None: ...
